{
  "name": "YouTube Easy Ad-Free Extension",
  "description": "You can easily get redirected to ad-free version of any video you want",
  "version": "1.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "main.html"
  },
  "content_scripts": [
    {
      "js": ["script.js"],
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"]
}